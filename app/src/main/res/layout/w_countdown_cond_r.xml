<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/bg_r2" android:tint="#E6202124" android:importantForAccessibility="no"/>
    <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="end|center_vertical" android:padding="14dp">
        <TextView android:id="@+id/line1" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed" android:textSize="48sp" android:textColor="#FFFFFF" android:gravity="end|center_vertical"
            android:includeFontPadding="false" android:maxLines="1" android:text="49"/>
        <TextView android:id="@+id/line2" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed" android:textSize="13sp" android:textColor="#FFFFFF" android:gravity="end|center_vertical"
            android:includeFontPadding="false" android:layout_marginTop="4dp" android:alpha="0.85" android:maxLines="2" android:ellipsize="end" android:text="днів до Нового року"/>
    </LinearLayout>
</FrameLayout>
