<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/bg_r2" android:tint="#E6202124" android:importantForAccessibility="no"/>
    <LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center" android:padding="14dp">
        <TextView android:id="@+id/line1" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="sans-serif" android:textSize="22sp" android:textColor="#FFFFFF" android:gravity="center"
            android:includeFontPadding="false" android:maxLines="6" android:ellipsize="end" android:text="Роби. Не чекай."/>
        <TextView android:id="@+id/line2" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="sans-serif" android:textSize="13sp" android:textColor="#FFFFFF" android:gravity="center"
            android:includeFontPadding="false" android:layout_marginTop="6dp" android:alpha="0.75" android:maxLines="2" android:text=""/>
    </LinearLayout>
</FrameLayout>
